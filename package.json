{
  "name": "maa-yashoda",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-react-ssg build",
    "postbuild": "node -e \"require('fs').copyFileSync('dist/404/index.html','dist/404.html')\"",
